#!/usr/bin/env bash
set -euo pipefail

skills_cli_version="1.5.25"
export DISABLE_TELEMETRY=1

if ! command -v npx >/dev/null 2>&1 && command -v mise >/dev/null 2>&1; then
  mise use -g --quiet node
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "npx is required to refresh external skills" >&2
  exit 1
fi

refresh() {
  local source="$1"
  local skill="$2"

  echo "refreshing $skill from $source"
  npx --yes "skills@$skills_cli_version" add "$source" \
    --global \
    --agent opencode \
    --agent claude-code \
    --agent codex \
    --skill "$skill" \
    --yes
}

refresh JuliusBrussee/caveman caveman
refresh DietrichGebert/ponytail ponytail
refresh obra/superpowers '*'
