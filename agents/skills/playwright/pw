#!/usr/bin/env bash
set -uo pipefail
profile="${PW_PROFILE:-y2g}"
case "$profile" in
  y2g) entry=playwright/token-y2g dir=Default ;;
  personal) entry=playwright/token-personal dir="Profile 1" ;;
  *) echo "pw: PW_PROFILE must be y2g or personal" >&2; exit 2 ;;
esac
token="$(pass show "$entry" 2>/dev/null | head -n1)"
[ -n "$token" ] || { echo "pw: pass entry $entry is missing or empty" >&2; exit 2; }
run() {
  PLAYWRIGHT_MCP_PROFILE_DIR_NAME="${PLAYWRIGHT_MCP_PROFILE_DIR_NAME:-$dir}" \
  PLAYWRIGHT_MCP_EXTENSION_TOKEN="$token" \
  NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require $(dirname "$(readlink -f "$0")")/background-connect.cjs" \
    npx -y @playwright/cli@latest "$@" 2>&1 | sed -e 's/token=[^&[:space:]]*/token=<redacted>/g' -e 's#chrome-extension://[^)[:space:]]*connect\.html[^)[:space:]]*#<connect tab>#g'
  return "${PIPESTATUS[0]}"
}
run "$@"
rc=$?
session=()
for a in "$@"; do case "$a" in -s=*) session=("$a") ;; esac; done
if [ "$rc" -eq 0 ] && printf '%s\n' "$@" | grep -qx tab-new; then
  idx=$(run "${session[@]}" tab-list | sed -n 's/^- \([0-9]*\):.*<connect tab>.*/\1/p' | head -n1)
  [ -n "$idx" ] && run "${session[@]}" tab-close "$idx" >/dev/null
fi
exit "$rc"
