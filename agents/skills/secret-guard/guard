#!/usr/bin/env python3
import json
import os
import pathlib
import subprocess
import sys

SKILL = pathlib.Path(__file__).absolute().parent
HOOK = f"python3 {SKILL / 'scrub'}"

DENY = [
    "Read(~/.config/sops/age/**)",
    "Read(~/.config/**/token*)",
    "Read(~/.config/gh/hosts.yml)",
    "Read(~/.password-store/**)",
    "Read(~/.ssh/id_*)",
    "Read(~/.netrc)",
    "Read(~/.git-credentials)",
    "Read(~/.aws/credentials)",
    "Read(~/.claude/.credentials.json)",
    "Read(~/.codex/auth.json)",
    "Read(//**/.env)",
    "Read(//**/.env.*)",
    "Read(//**/*.pem)",
    "Read(//**/*.key)",
    "Read(//**/*.keystore)",
    "Read(//**/*.jks)",
    "Read(//**/*.p12)",
    "Read(//proc/*/environ)",
    "Bash(env)",
    "Bash(printenv)",
    "Bash(printenv *)",
    "Bash(export -p)",
    "Bash(declare -x)",
    "Bash(set)",
    "Bash(sops -d *)",
    "Bash(sops --decrypt *)",
    "Bash(sops decrypt *)",
    "Bash(age -d *)",
    "Bash(age --decrypt *)",
    "Bash(gpg -d *)",
    "Bash(gpg --decrypt *)",
    "Bash(pass *)",
    "Bash(gh auth token*)",
]

CANARY = "gh" + "p_" + "SecretGuardCanary0FakeValue0000000000"


def settings():
    return {
        "hooks": {
            "PreToolUse": [
                {
                    "matcher": "Bash",
                    "hooks": [
                        {"type": "command", "command": f"{HOOK} --wrap", "timeout": 10}
                    ],
                }
            ],
            "PostToolUse": [
                {
                    "matcher": "*",
                    "hooks": [{"type": "command", "command": HOOK, "timeout": 10}],
                }
            ],
        },
        "permissions": {"deny": DENY},
    }


def settings_files():
    config = pathlib.Path(
        os.environ.get("CLAUDE_CONFIG_DIR", pathlib.Path.home() / ".claude")
    )
    files = [
        config / "settings.json",
        pathlib.Path("/etc/claude-code/managed-settings.json"),
    ]
    root = pathlib.Path.cwd()
    for parent in [root, *root.parents]:
        files += [
            parent / ".claude/settings.json",
            parent / ".claude/settings.local.json",
        ]
    return [f for f in files if f.is_file()]


def doctor():
    hooked, wrapped, denied, problems = [], [], set(), []
    for path in settings_files():
        try:
            data = json.loads(path.read_text())
        except Exception as error:
            problems.append(f"{path}: unreadable ({type(error).__name__})")
            continue
        for group in data.get("hooks", {}).get("PostToolUse", []):
            for hook in group.get("hooks", []):
                if "secret-guard/scrub" in hook.get("command", ""):
                    hooked.append(f"{path} (matcher {group.get('matcher', '*')!r})")
        for group in data.get("hooks", {}).get("PreToolUse", []):
            for hook in group.get("hooks", []):
                if "secret-guard/scrub --wrap" in hook.get("command", ""):
                    wrapped.append(f"{path} (matcher {group.get('matcher', '*')!r})")
        denied |= set(data.get("permissions", {}).get("deny", [])) & set(DENY)

    probe = {"hook_event_name": "PostToolUse", "tool_response": {"stdout": CANARY}}
    done = subprocess.run(
        [sys.executable, SKILL / "scrub"],
        input=json.dumps(probe),
        capture_output=True,
        text=True,
    )
    works = "[redacted:github-token]" in done.stdout and CANARY not in done.stdout

    print(f"scrubber self-test: {'ok' if works else 'FAILED'}")
    print("PostToolUse hook configured in:", ", ".join(hooked) if hooked else "NOWHERE")
    print(
        "PreToolUse Bash wrapper configured in:",
        ", ".join(wrapped) if wrapped else "NOWHERE",
    )
    print(f"deny rules present: {len(denied)}/{len(DENY)}")
    for rule in DENY:
        if rule not in denied:
            print(f"  missing: {rule}")
    for problem in problems:
        print(f"  {problem}")
    print(
        "live check, read by the agent: the next line shows [redacted:github-token] only if the hook is active in this session"
    )
    print(f"canary: {CANARY}")
    return 0 if works and hooked and wrapped and len(denied) == len(DENY) else 1


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "install":
        print(json.dumps(settings(), indent=2))
        return 0
    if command == "doctor":
        return doctor()
    print("usage: guard install | guard doctor", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
