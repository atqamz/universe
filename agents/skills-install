#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ref="$(tr -d '[:space:]' < "$root/skills.ref")"

if [ -z "$ref" ]; then
  echo "agents/skills.ref is empty" >&2
  exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "gh is required to install skills" >&2
  exit 1
fi

installed="$(mktemp)"
trap 'rm -f -- "$installed"' EXIT
gh skill list --scope user --json path,sourceURL \
  --jq '.[] | select(.sourceURL == "https://github.com/atqamz/skills") | .path' > "$installed"

while IFS= read -r skill_dir; do
  [ -d "$skill_dir" ] || continue
  [ -L "$skill_dir" ] && continue
  case "$skill_dir" in
    "$HOME/.claude/skills"/*|"$HOME/.agents/skills"/*|"$HOME/.config/opencode/skills"/*)
      rm -rf -- "$skill_dir"
      ;;
  esac
done < "$installed"

for agent in claude-code codex opencode; do
  gh skill install atqamz/skills --all --pin "$ref" --scope user --agent "$agent" --force
done

while IFS= read -r skill_dir; do
  [ -d "$skill_dir" ] || continue
  while IFS= read -r -d '' file; do
    if head -1 -- "$file" | grep -q '^#!'; then
      chmod +x -- "$file"
    fi
  done < <(find "$skill_dir" -type f -print0)
done < <(gh skill list --scope user --json path,sourceURL \
  --jq '.[] | select(.sourceURL == "https://github.com/atqamz/skills") | .path')
