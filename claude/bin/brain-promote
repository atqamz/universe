#!/usr/bin/env bash
# brain-promote: daily batch agent that turns recent brain/log/ digests into
# proposed brain/notes/ updates on a PR branch. Human review is required before
# merge; notes/ stays canon.
#
# Defaults to the local Ollama API (which proxies to a cloud model such as
# kimi-k2.7-code:cloud). Override with BRAIN_PROMOTE_PROVIDER=claude to use
# the claude CLI instead.
set -euo pipefail

brain="${BRAIN_DIR:-$HOME/brain}"
manifest="$brain/.brain-promote-manifest.json"
provider="${BRAIN_PROMOTE_PROVIDER:-ollama}"
ollama_model="${BRAIN_PROMOTE_OLLAMA_MODEL:-kimi-k2.7-code:cloud}"
ollama_url="${BRAIN_PROMOTE_OLLAMA_URL:-http://localhost:11434/api/generate}"
claude_model="${BRAIN_PROMOTE_CLAUDE_MODEL:-sonnet}"
max_logs="${BRAIN_PROMOTE_MAX_LOGS:-80}"
dry_run="${BRAIN_PROMOTE_DRY_RUN:-0}"

log() { echo "[brain-promote] $*"; }
warn() { echo "[brain-promote] WARN: $*" >&2; }
fail() { echo "[brain-promote] ERROR: $*" >&2; exit 1; }

if ! command -v gh >/dev/null 2>&1; then fail "gh CLI not on PATH"; fi
if ! command -v git >/dev/null 2>&1; then fail "git not on PATH"; fi

if [ "$provider" = "claude" ]; then
  if ! command -v claude >/dev/null 2>&1; then fail "claude CLI not on PATH"; fi
  case "$claude_model" in
    sonnet|haiku|opus|fable) ;;
    *) fail "BRAIN_PROMOTE_CLAUDE_MODEL=$claude_model must be sonnet, haiku, opus, or fable"; ;;
  esac
fi

# --- ensure brain is on main and clean ---
cd "$brain"
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" != "main" ]; then
  if git checkout -q main 2>/dev/null && git pull --ff-only >/dev/null 2>&1; then
    :
  else
    fail "brain on branch $current_branch and cannot checkout main"
  fi
fi
if [ -n "$(git status --porcelain)" ]; then
  fail "brain worktree dirty; promotion requires clean state"
fi

# --- seed manifest ---
[ -f "$manifest" ] || echo '{"version":2,"last_processed_ts":"19700101T000000Z","groups":{}}' > "$manifest"

# --- run the python core ---
export BRAIN_DIR="$brain" MANIFEST="$manifest" PROVIDER="$provider" \
  OLLAMA_MODEL="$ollama_model" OLLAMA_URL="$ollama_url" \
  CLAUDE_MODEL="$claude_model" MAX_LOGS="$max_logs" DRY_RUN="$dry_run"
python3 <<'PY'
import os, re, json, hashlib, subprocess, datetime, sys, urllib.request, urllib.error
from pathlib import Path

brain = Path(os.environ["BRAIN_DIR"])
manifest_path = brain / ".brain-promote-manifest.json"
provider = os.environ["PROVIDER"]
ollama_model = os.environ["OLLAMA_MODEL"]
ollama_url = os.environ["OLLAMA_URL"]
claude_model = os.environ["CLAUDE_MODEL"]
max_logs = int(os.environ["MAX_LOGS"])
dry_run = os.environ["DRY_RUN"] == "1"
today = datetime.date.today().isoformat()
now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
log_dir = brain / "log"
notes_dir = brain / "notes"
index_path = brain / "index.md"

def log(msg): print(f"[brain-promote] {msg}")
def warn(msg): print(f"[brain-promote] WARN: {msg}", file=sys.stderr)
def fail(msg): print(f"[brain-promote] ERROR: {msg}", file=sys.stderr); sys.exit(1)

def shell(cmd, cwd=None, input=None, timeout=60):
    r = subprocess.run(cmd, cwd=cwd, input=input, capture_output=True, text=True, timeout=timeout)
    return r

def parse_frontmatter(text):
    fm_re = re.compile(r"^---\n(.*?)\n---\n?(.*)$", re.S)
    m = fm_re.match(text)
    if not m:
        return {}, text
    fm_raw, body = m.group(1), m.group(2)
    fm, cur = {}, None
    for line in fm_raw.splitlines():
        if not line.strip():
            continue
        if line.startswith("  ") and cur is not None:
            k, _, v = line.strip().partition(":")
            cur[k.strip()] = v.strip()
        elif line.rstrip().endswith(":"):
            key = line.rstrip().rstrip(":").strip()
            cur = {}
            fm[key] = cur
        else:
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
            cur = None
    return fm, body

def content_hash(text):
    return hashlib.sha256(text.encode()).hexdigest()[:16]

def safe_filename(s):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", s).strip("-").strip(".")

def strip_preamble(text):
    preamble_re = re.compile(r"(?i)^(rewriting|here('?s| is)|i'?ll|i am|sure|okay|ok|let me|now[,:]?|done|rewritten|got it|certainly)\b")
    lines = text.split("\n")
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    if i < len(lines) and preamble_re.match(lines[i].strip()):
        for j in range(i + 1, len(lines)):
            if lines[j].strip() == "---":
                return "\n".join(lines[j + 1:]).strip()
        return "\n".join(lines[i + 1:]).strip()
    return text.strip()

def clean_model_output(text):
    text = re.sub(r"^```markdown\n", "", text)
    text = re.sub(r"^```\n", "", text)
    text = re.sub(r"\n```\s*$", "", text)
    return strip_preamble(text)

def ts_from_filename(path):
    m = re.match(r"^(\d{8}T\d{6}Z)", path.name)
    return m.group(1) if m else "99999999T999999Z"

def call_ollama(system_prompt, user_prompt):
    payload = json.dumps({
        "model": ollama_model,
        "prompt": f"{system_prompt}\n\n{user_prompt}",
        "stream": False,
        "options": {"temperature": 0.3},
    }).encode()
    req = urllib.request.Request(ollama_url, data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            data = json.loads(resp.read().decode())
            return (data.get("response") or "").strip()
    except urllib.error.HTTPError as e:
        body = e.read().decode()[:200]
        warn(f"ollama HTTP {e.code}: {body}")
        return None
    except Exception as e:
        warn(f"ollama request failed: {e}")
        return None

def call_claude(system_prompt, user_prompt):
    for attempt in range(3):
        try:
            r = subprocess.run(
                ["claude", "-p", "--model", claude_model, "--max-turns", "8", "--tools", "",
                 "--append-system-prompt", system_prompt],
                input=user_prompt[:12000], capture_output=True, text=True, timeout=180,
            )
            out = (r.stdout or "").strip()
            if r.returncode != 0 or re.match(r"^Error:\s", out) or not out:
                warn(f"claude attempt {attempt+1} failed: {out[:100]}")
                continue
            return clean_model_output(out)
        except Exception as ex:
            warn(f"claude attempt {attempt+1} raised: {ex}")
    return None

def llm(system_prompt, user_prompt):
    if provider == "ollama":
        out = call_ollama(system_prompt, user_prompt)
        if out:
            return out
        warn("ollama unavailable; falling back to claude")
        return call_claude(system_prompt, user_prompt)
    return call_claude(system_prompt, user_prompt)

# Load manifest
manifest = json.loads(manifest_path.read_text() or "{}")
if not isinstance(manifest, dict) or manifest.get("version") != 2:
    manifest = {"version": 2, "last_processed_ts": manifest.get("last_processed_ts", "19700101T000000Z"), "groups": {}}
groups_manifest = manifest.setdefault("groups", {})
last_ts = manifest.get("last_processed_ts", "19700101T000000Z")

# --- parse index for existing notes ---
index_lines = []
index_notes = {}
if index_path.exists():
    raw_index = index_path.read_text()
    index_lines = raw_index.splitlines()
    for line in index_lines:
        m = re.match(r"^-\s*`([^`]+)`\s*—\s*\"(.*?)\"", line)
        if m:
            slug, desc = m.group(1), m.group(2)
            index_notes[slug] = {"slug": slug, "description": desc}

existing_notes = {}
for f in notes_dir.glob("*.md"):
    if f.name == ".gitkeep":
        continue
    slug = f.stem
    text = f.read_text(errors="ignore")
    fm, body = parse_frontmatter(text)
    existing_notes[slug] = {"path": f, "frontmatter": fm, "body": body}

# --- collect candidate logs ---
all_logs = sorted(log_dir.glob("*.md"), key=lambda p: ts_from_filename(p))
candidates = [p for p in all_logs if ts_from_filename(p) > last_ts]
if len(candidates) > max_logs:
    log(f"capping {len(candidates)} new logs to {max_logs} most recent")
    candidates = candidates[-max_logs:]

if not candidates:
    log("no new log entries since last promotion; nothing to do")
    sys.exit(0)

log(f"processing {len(candidates)} log entries since {last_ts}")

# --- parse each log entry ---
log_entries = []
for p in candidates:
    text = p.read_text(errors="ignore")
    fm, body = parse_frontmatter(text)
    title_match = re.search(r"^##\s+(.+)$", body, re.M)
    title = title_match.group(1).strip() if title_match else "(untitled)"
    bullets = [m.group(1).strip() for m in re.finditer(r"^[-*]\s+(.+)$", body, re.M)]
    prov_match = re.search(r"\*\*Provenance:\*\*\s+session\s+`([^`]+)`\s+·\s+cwd\s+`([^`]+)`\s+·\s+(\d{8}T\d{6}Z)", text)
    session_id, cwd, prov_ts = (prov_match.groups() if prov_match else ("", "", ts_from_filename(p)))
    log_entries.append({
        "path": p, "ts": ts_from_filename(p), "title": title, "bullets": bullets,
        "body": body, "session_id": session_id, "cwd": cwd, "provenance_ts": prov_ts,
    })

# --- infer target note for each log entry ---
def infer_note_slug(entry):
    cwd = entry["cwd"] or ""
    home = str(Path.home())
    rel = cwd.removeprefix(home).strip("/")
    parts = rel.split("/")
    head = ""
    if len(parts) >= 2 and parts[0] in ("repo", "workspace"):
        head = parts[1]
    elif len(parts) >= 1:
        head = parts[0]

    query = (entry["title"] + " " + " ".join(entry["bullets"])).lower()
    best_slug, best_score = None, 0
    for slug, meta in index_notes.items():
        score = 0
        if head and head in slug:
            score += 5
        for word in re.findall(r"[a-z0-9_]+", slug.lower()):
            if len(word) > 3 and word in query:
                score += 1
        if score > best_score:
            best_score = score
            best_slug = slug
    if best_slug and best_score >= 4:
        return best_slug, "existing"
    return None, "new"

for e in log_entries:
    slug, reason = infer_note_slug(e)
    e["target_slug"] = slug
    e["target_reason"] = reason

# Group by target slug
new_groups = {}
for e in log_entries:
    slug = e["target_slug"]
    if slug is None:
        continue
    new_groups.setdefault(slug, []).append(e)

if not new_groups:
    log("no log entries mapped to notes; skipping")
    sys.exit(0)

log(f"grouped into {len(new_groups)} candidate note updates")

# --- LLM merge function ---
def merge_note(slug, entries, existing_fm, existing_body):
    sources = "\n\n---\n\n".join(
        f"Source: {e['path'].name} (cwd: {e['cwd']})\n## {e['title']}\n" + "\n".join(f"- {b}" for b in e["bullets"])
        for e in entries
    )
    existing_section = ""
    if existing_body:
        existing_section = f"\n\nExisting note body:\n---\n{existing_body}\n---\n"
    system_prompt = (
        "You are updating a canonical personal-memory note. Merge the new log sources "
        "into the existing note (if any). Preserve the tone and factual density. "
        "Add only grounded facts/decisions/outcomes. Remove or mark outdated claims only "
        "when a source explicitly supersedes them. Do NOT add preamble or narration. "
        "Output ONLY the updated note body (no frontmatter, no code fences around the whole body)."
    )
    user_prompt = f"Note slug: {slug}\n\nNew sources to integrate:\n{sources}{existing_section}"
    return clean_model_output(llm(system_prompt, user_prompt) or "")

def new_note_slug_and_frontmatter(entries):
    sources = "\n\n---\n\n".join(
        f"Source: {e['path'].name} (cwd: {e['cwd']})\n## {e['title']}\n" + "\n".join(f"- {b}" for b in e["bullets"])
        for e in entries
    )
    system_prompt = (
        "You are proposing a new canonical brain note. Based on the log sources, "
        "output ONLY a JSON object with keys: slug (string, format like home-atqa-<context>__<topic>), "
        "description (one-line string), body (markdown string). No preamble."
    )
    out = llm(system_prompt, sources)
    if not out:
        return None
    out = re.sub(r"^```json\n", "", out)
    out = re.sub(r"\n```\s*$", "", out)
    out = strip_preamble(out)
    if not out:
        return None
    try:
        data = json.loads(out)
        if "slug" in data and "body" in data:
            data["slug"] = safe_filename(data["slug"])
            return data
    except Exception:
        pass
    return None

# --- produce proposed note files ---
proposed = []
for slug, entries in new_groups.items():
    existing = existing_notes.get(slug)
    if existing:
        fm = dict(existing["frontmatter"])
        old_body = existing["body"]
        new_body = merge_note(slug, entries, fm, old_body)
        if not new_body:
            warn(f"merge failed for {slug}; skipping")
            continue
        old_hash = content_hash(existing["path"].read_text())
        fm.setdefault("name", slug)
        fm_meta = fm.setdefault("metadata", {})
        if isinstance(fm_meta, dict):
            fm_meta["promoted_from_log"] = True
            fm_meta["promoted_at"] = now_iso
        proposed.append({
            "slug": slug, "path": notes_dir / f"{slug}.md",
            "frontmatter": fm, "body": new_body,
            "old_hash": old_hash, "sources": [e["path"].name for e in entries],
            "is_new": False,
        })
    else:
        data = new_note_slug_and_frontmatter(entries)
        if not data:
            warn("new-note proposal failed for group; skipping")
            continue
        slug = data["slug"]
        fm = {
            "name": slug,
            "description": data.get("description", ""),
            "metadata": {
                "node_type": "memory",
                "type": "project",
                "promoted_from_log": True,
                "promoted_at": now_iso,
            },
        }
        proposed.append({
            "slug": slug, "path": notes_dir / f"{slug}.md",
            "frontmatter": fm, "body": clean_model_output(data["body"]),
            "old_hash": None, "sources": [e["path"].name for e in entries],
            "is_new": True,
        })

if not proposed:
    log("no proposed updates generated")
    sys.exit(0)

# --- prepare branch ---
branch = f"brain-promote-{today.replace('-', '')}"
base_branch = branch
suffix = 1
while shell(["git", "rev-parse", "--verify", f"{branch}^{{}}"], cwd=brain).returncode == 0 or \
      shell(["git", "ls-remote", "--heads", "origin", branch], cwd=brain).stdout.strip():
    branch = f"{base_branch}-{suffix}"
    suffix += 1

log(f"using branch {branch} ({len(proposed)} note updates)")

if dry_run:
    log("DRY RUN: printing proposed updates only")
    for p in proposed:
        print(f"\n=== {p['slug']} ({'new' if p['is_new'] else 'update'}) ===")
        print(f"path: {p['path']}")
        print(f"sources: {', '.join(p['sources'])}")
        print("--- frontmatter ---")
        print(json.dumps(p["frontmatter"], indent=2))
        print("--- body ---")
        print(p["body"][:2000])
        print("..." if len(p["body"]) > 2000 else "")
    sys.exit(0)

# Create branch off main and write files
res = shell(["git", "checkout", "-b", branch, "main"], cwd=brain)
if res.returncode != 0:
    fail(f"failed to create branch {branch}: {res.stderr}")

def serialize_frontmatter(fm):
    lines = ["---"]
    for k, v in fm.items():
        if isinstance(v, dict):
            lines.append(f"{k}:")
            for kk, vv in v.items():
                lines.append(f"  {kk}: {vv}")
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines)

index_updated = False
for p in proposed:
    text = serialize_frontmatter(p["frontmatter"]) + "\n\n" + p["body"].strip() + "\n"
    p["path"].parent.mkdir(parents=True, exist_ok=True)
    p["path"].write_text(text)

    if p["is_new"]:
        desc = p["frontmatter"].get("description", "")
        index_line = f"- `{p['slug']}` — \"{desc}\""
        if not any(p["slug"] in line for line in index_lines):
            insert_idx = len(index_lines)
            for i, line in enumerate(index_lines):
                if line.startswith("- `") and line > index_line:
                    insert_idx = i
                    break
            index_lines.insert(insert_idx, index_line)
            index_updated = True

    res = shell(["git", "add", str(p["path"])], cwd=brain)
    if res.returncode != 0:
        warn(f"git add failed for {p['slug']}: {res.stderr}")
        continue
    res = shell(["git", "commit", "-m", f"update note {p['slug']}"], cwd=brain)
    if res.returncode != 0:
        warn(f"git commit failed for {p['slug']}: {res.stderr}")

if index_updated:
    index_path.write_text("\n".join(index_lines) + "\n")
    res = shell(["git", "add", str(index_path)], cwd=brain)
    if res.returncode == 0:
        shell(["git", "commit", "-m", f"update index for {today}"], cwd=brain)

# Update manifest
for p in proposed:
    gm = groups_manifest.setdefault(p["slug"], {})
    gm["last_promote"] = now_iso
    gm["sources"] = gm.get("sources", []) + p["sources"]
    gm["sources"] = gm["sources"][-50:]
    gm["body_hash"] = content_hash(p["body"])
manifest["last_processed_ts"] = max(e["ts"] for e in log_entries)
manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True))

res = shell(["git", "add", str(manifest_path)], cwd=brain)
if res.returncode == 0:
    shell(["git", "commit", "-m", f"update brain-promote manifest for {today}"], cwd=brain)

# Push branch
res = shell(["git", "push", "-u", "origin", branch], cwd=brain, timeout=120)
if res.returncode != 0:
    fail(f"push failed: {res.stderr}")

# Open PR
pr_body = f"""## Summary
Daily brain promotion for {today}: {len(proposed)} note update(s) derived from {len(candidates)} log digest(s).

## Notes changed
"""
for p in proposed:
    action = "new" if p["is_new"] else "update"
    pr_body += f"- `{p['slug']}` ({action})\n"

pr_body += """
## Review checklist
- [ ] Each updated note is grounded in the cited log sources.
- [ ] No canonized speculation or filler.
- [ ] Merge only when ready.
"""

res = shell([
    "gh", "pr", "create",
    "--title", f"brain-promote {today}: {len(proposed)} note(s)",
    "--body", pr_body,
    "--base", "main",
    "--assignee", "atqamz",
], cwd=brain, timeout=120)

if res.returncode != 0:
    warn(f"PR creation failed: {res.stderr}")
    print(res.stdout)
    sys.exit(1)

log(f"opened PR: {res.stdout.strip()}")
PY
