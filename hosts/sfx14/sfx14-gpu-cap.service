[Unit]
Description=Cap SFX14 NVIDIA clocks (lock 1540MHz, +200MHz VF offset)
Documentation=https://github.com/atqamz/universe/blob/main/docs/workstation.md
# /dev/nvidiactl appears a few seconds after the module loads, which is after
# this unit was reached at boot, so the old ConditionPathExists on it silently
# skipped the unit. nvidia-modprobe is the vendor tool for creating the nodes.
ConditionPathExists=/usr/bin/nvidia-modprobe
After=systemd-modules-load.service suspend.target hibernate.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/nvidia-modprobe -c 0 -u
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -lgc 210,1540
# The +200MHz VF offset is what actually lowers voltage: the locked 1540MHz then
# runs at the voltage point that 1340MHz would normally use. nvidia-smi only
# exposes negative derate on GeForce, so go through NVML.
ExecStart=/usr/bin/python3 -c "import pynvml; pynvml.nvmlInit(); pynvml.nvmlDeviceSetGpcClkVfOffset(pynvml.nvmlDeviceGetHandleByIndex(0), 200); pynvml.nvmlShutdown()"

[Install]
WantedBy=multi-user.target suspend.target hibernate.target
