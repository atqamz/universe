#!/usr/bin/env bash
set -euo pipefail

plugins_json="${HOME}/.claude/plugins/installed_plugins.json"
target="${HOME}/dotagents/skills"
opencode_adapter="${HOME}/dotagents/adapters/opencode/skills"

plugin_path() {
  jq -r --arg name "$1" '.plugins[$name][0].installPath // empty' "$plugins_json"
}

sync_plugin() {
  local name="$1"
  local dir="$2"
  local source

  source="$(plugin_path "$name")"
  if [ -z "$source" ] || [ ! -d "$source/skills" ]; then
    printf 'missing skills for %s\n' "$name" >&2
    return 1
  fi

  rm -rf "$target/$dir"
  mkdir -p "$target"
  cp -R "$source/skills" "$target/$dir"
}

sync_plugin "caveman@caveman" "caveman"
sync_plugin "ponytail@ponytail" "ponytail"
sync_plugin "superpowers@claude-plugins-official" "superpowers"

rm -rf "$opencode_adapter"
mkdir -p "$opencode_adapter"

for group in caveman ponytail superpowers; do
  for skill in "$target/$group"/*; do
    [ -d "$skill" ] || continue
    [ -f "$skill/SKILL.md" ] || continue
    ln -s "../../../skills/$group/$(basename "$skill")" "$opencode_adapter/$(basename "$skill")"
  done
done
