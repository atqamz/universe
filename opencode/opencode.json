{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "github": {
      "path": "~/github",
      "description": "GitHub repos workspace (yes2games, others)"
    },
    "universe": {
      "path": "~/universe",
      "description": "NixOS flake - hosts, modules, parts, pkgs, scripts"
    },
    "vault": {
      "path": "~/vault",
      "description": "Secrets and age keys"
    },
    "dotagents": {
      "path": "~/dotagents",
      "description": "AI agent configs and AGENTS.md rules"
    },
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "NixOS system and home configs - fish, hypr, fastfetch, zed, cs2, herdr, caelestia"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9router",
      "options": {
        "baseURL": "https://router.luckynee.com/v1",
        "apiKey": "{file:/run/secrets/ninerouter-api-key}"
      },
      "models": {
        "kr/claude-sonnet-4.6": { "name": "Claude Sonnet 4.6" },
        "kr/claude-sonnet-4.6-thinking": { "name": "Claude Sonnet 4.6 Thinking", "reasoning": true },
        "kr/claude-opus-4.8": { "name": "Claude Opus 4.8" },
        "kr/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "ollama/glm-5": { "name": "GLM 5" },
        "ollama/glm-4.7-flash": { "name": "GLM 4.7 Flash" },
        "ollama/qwen3.5": { "name": "Qwen 3.5" },
        "ollama/minimax-m3": { "name": "MiniMax M3" },
        "ollama/deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "ollama/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "ollama/glm-5.2": { "name": "GLM 5.2" },
        "cx/gpt-5.5": { "name": "GPT 5.5" }
      }
    }
  },
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 200000
  },
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/**": "ask"
    },
    "write": {
      "*": "allow",
      "~/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease*": "deny",
      ": (){ :|:& };:*": "deny",
      "mkfs*": "deny",
      "dd if=*of=/dev/*": "deny",
      "chmod -R * / *": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
      "sudo *": "ask"
    }
  }
}
