{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "github": {
      "path": "~/github",
      "description": "GitHub repos workspace (yes2games, others)"
    },
    "universe": {
      "path": "~/universe",
      "description": "NixOS flake - hosts, modules, parts, pkgs, scripts"
    },
    "vault": {
      "path": "~/vault",
      "description": "Secrets and age keys"
    },
    "dotagents": {
      "path": "~/dotagents",
      "description": "AI agent configs and AGENTS.md rules"
    },
    "dotfiles": {
      "path": "~/dotfiles",
      "description": "NixOS system and home configs - fish, hypr, fastfetch, zed, cs2, herdr, caelestia"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9router",
      "options": {
        "baseURL": "https://router.luckynee.com/v1",
        "apiKey": "{file:/run/secrets/ninerouter-api-key}"
      },
      "models": {
        "atqa-gpt-glm": {
          "name": "atqa-gpt-glm"
        },
        "cx/gpt-5.5": {
          "name": "cx/gpt-5.5"
        },
        "cx/gpt-5.5-xhigh": {
          "name": "cx/gpt-5.5-xhigh"
        },
        "glm-5.2-visual": {
          "name": "glm-5.2-visual"
        },
        "kr/claude-opus-4.8": {
          "name": "kr/claude-opus-4.8"
        },
        "kr/claude-sonnet-4.6": {
          "name": "kr/claude-sonnet-4.6"
        },
        "kr/claude-sonnet-4.6-thinking": {
          "name": "kr/claude-sonnet-4.6-thinking",
          "reasoning": true
        },
        "kr/claude-sonnet-5": {
          "name": "kr/claude-sonnet-5"
        },
        "nvidia/deepseek-ai/deepseek-v4-flash": {
          "name": "nvidia/deepseek-ai/deepseek-v4-flash"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro": {
          "name": "nvidia/deepseek-ai/deepseek-v4-pro"
        },
        "nvidia/minimaxai/minimax-m2.7": {
          "name": "nvidia/minimaxai/minimax-m2.7"
        },
        "nvidia/minimaxai/minimax-m3": {
          "name": "nvidia/minimaxai/minimax-m3"
        },
        "nvidia/moonshotai/kimi-k2.6": {
          "name": "nvidia/moonshotai/kimi-k2.6"
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "nvidia/nemotron-3-ultra-550b-a55b"
        },
        "nvidia/parakeet-ctc-1.1b-asr": {
          "name": "nvidia/parakeet-ctc-1.1b-asr"
        },
        "nvidia/z-ai/glm-5.2": {
          "name": "nvidia/z-ai/glm-5.2"
        },
        "ollama/deepseek-v4-flash": {
          "name": "ollama/deepseek-v4-flash"
        },
        "ollama/deepseek-v4-pro": {
          "name": "ollama/deepseek-v4-pro"
        },
        "ollama/glm-5.2": {
          "name": "ollama/glm-5.2"
        },
        "ollama/kimi-k2.7-code": {
          "name": "ollama/kimi-k2.7-code"
        },
        "ollama/minimax-m3": {
          "name": "ollama/minimax-m3"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 200000
  },
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/**": "ask"
    },
    "write": {
      "*": "allow",
      "~/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease*": "deny",
      ": (){ :|:& };:*": "deny",
      "mkfs*": "deny",
      "dd if=*of=/dev/*": "deny",
      "chmod -R * / *": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
      "sudo *": "ask"
    }
  }
}
